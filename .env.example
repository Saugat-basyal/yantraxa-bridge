# Environment variables the bridge reads. None is required; copy into your shell or
# service unit as needed. Settings proper live in $YANTRAXA_HOME/config.toml.

# Where config.toml, credentials (0600), bridge_key.pem (0600) and summaries/ live.
# Default: ~/.yantraxa. Point it at a temporary directory for throwaway runs and tests.
YANTRAXA_HOME=

# Default Ollama address when config.toml sets no ollama_host.
# Default: http://127.0.0.1:11434
OLLAMA_HOST=

# Log level for `yantraxa-bridge run`: debug, info or warning. Default: info.
YANTRAXA_LOG_LEVEL=info
